#!/bin/bash
#
# Originally: "MySQL is accessable via network. Do you want me to turn it off?"
# and, on yes, skip-networking in my.cnf.
#
# ⚠️ That answer is wrong for a development stack, and it broke a working
# machine on 05/08/2026. With skip-networking MariaDB accepts Unix sockets
# only, so every project pointing at 127.0.0.1:3306, which is every Laravel and
# every WordPress, stops connecting at the next restart. The default answer was
# yes, so it happened by pressing return.
#
# The protection that was wanted is real: MariaDB with no bind-address listens
# on every interface, so anyone on the same network can reach the database.
# bind-address=127.0.0.1 gives exactly that protection and costs nothing: the
# port stays open on loopback, projects keep working, and the machine next to
# yours cannot see it.
#
# So this script does two things instead of one:
#   - undoes skip-networking if a previous run put it there
#   - sets bind-address to 127.0.0.1 if it is missing
#
# Part of VXOST, GPL-licensed like the file it replaces.
# Original copyright 2002-2003 Kai 'Oswald' Seidler, GPL v2.

if test "x$VXOST_ROOT" = "x"
then
	echo "Dont call this script directly!"
	exit 1
fi

. $VXOST_ROOT/share/vxost/vxostlib

if test "$1" = "check"
then
	check="true"
else
	check="false"
fi

bon="[1m"
boff="[m"

f="$VXOST_ROOT/etc/my.cnf"

# 1. skip-networking left behind by an older run, or by the original script.
active_skip=$(grep -c '^[[:space:]]*skip-networking' "$f")

if test "$active_skip" -gt 0
then
	$check && exit 1

	echo "VXOST: ${bon}" $($GETTEXT 'MySQL is not reachable over TCP at all.') "${boff}"
	echo "VXOST: " $($GETTEXT 'Every project that connects to 127.0.0.1:3306 is broken while this is on.')

	if asky $($GETTEXT "Do you want me to turn TCP back on?")
	then
		perl -pi -e 's/^(\s*)(skip-networking)/$1#$2/' "$f"
		echo "VXOST: " $($GETTEXT 'Turned back on.')
	fi
fi

# 2. The real hardening: listen on loopback only.
#
# ⚠️ Two things get confused here, and the script used to confuse both.
#
# THE GROUP. MariaDB does not read [mysqld] alone: [server], [mariadb],
# [mariadbd], [mysqld-X.Y], [mariadb-X.Y] and [client-server] are read too,
# and the LAST value wins. This file passed the check while the database
# answered the whole network:
#
#     [mysqld]
#     bind-address=127.0.0.1
#     [mariadb]
#     bind-address=0.0.0.0
#
# THE DAEMON. A correct file is not a protected server: MariaDB keeps the
# listener it opened at startup until it restarts. The old early return said
# "not reachable from the network. Good." without ever looking at a socket.
# File and daemon are two answers, and both get reported.

# The value of bind-address in the last server group that sets it. Empty if
# no server group sets it at all.
bind_value=$(awk '
	/^[[:space:]]*\[/ {
		g = $0
		sub(/^[[:space:]]*\[/, "", g)
		sub(/\].*$/, "", g)
		gsub(/[[:space:]]/, "", g)
		g = tolower(g)
		next
	}
	/^[[:space:]]*bind-address[[:space:]]*=/ {
		if (g == "mysqld" || g == "server" || g == "mariadb" || g == "mariadbd" \
		    || g == "client-server" || g ~ /^mysqld-[0-9]/ || g ~ /^mariadb-[0-9]/) {
			v = $0
			sub(/^[^=]*=[[:space:]]*/, "", v)
			sub(/[[:space:]#].*$/, "", v)
			value = v
		}
	}
	END { print value }' "$f")

# !include porta altre opzioni da un altro file: da qui non si vede cosa
# dicono, e dire "a posto" guardando solo questo sarebbe una risposta data
# senza aver guardato.
altrove=$(grep -c '^[[:space:]]*!include' "$f")

# Le due forme di netstat, che non sono la stessa su tutti i sistemi:
# 127.0.0.1.3306 su macOS, 127.0.0.1:3306 altrove.
mysql_listen_lines() {
	netstat -an 2>/dev/null | egrep "[.:]3306[[:space:]].*LISTEN"
}

# Vero se il demone ascolta su qualcosa che non e' il loopback.
mysql_listens_wide() {
	mysql_listen_lines | egrep -v "127\.0\.0\.1[.:]3306|\[?::1\]?[.:]3306" | grep -q .
}

# Vero se il demone ascolta, da qualche parte.
mysql_listens() {
	mysql_listen_lines | grep -q .
}

file_ok="false"
test "$bind_value" = "127.0.0.1" && test "$altrove" -eq 0 && file_ok="true"

daemon_ok="unknown"
if mysql_listens
then
	if mysql_listens_wide
	then
		daemon_ok="false"
	else
		daemon_ok="true"
	fi
else
	daemon_ok="stopped"
fi

if test "$check" = "true"
then
	# In modalita' check si esce 0 solo se non c'e' niente da fare: il file
	# giusto E il demone che non ascolta oltre il loopback.
	if test "$file_ok" = "true" && test "$daemon_ok" != "false"
	then
		exit 0
	fi
	exit 1
fi

if test "$file_ok" = "true"
then
	echo "VXOST: " $($GETTEXT 'my.cnf says bind-address=127.0.0.1.')
else
	if test "$altrove" -gt 0
	then
		echo "VXOST: ${bon}" $($GETTEXT 'my.cnf pulls in other files with !include: what bind-address ends up being cannot be read from here.') "${boff}"
	elif test -z "$bind_value"
	then
		echo "VXOST: ${bon}" $($GETTEXT 'No server group in my.cnf sets bind-address: MySQL listens on every network interface.') "${boff}"
	else
		echo "VXOST: ${bon}" $($GETTEXT 'The last server group in my.cnf sets bind-address to something other than 127.0.0.1: reachable from the network.') "${boff}"
		echo "VXOST: " "bind-address=$bind_value"
	fi

	if asky $($GETTEXT "Restrict it to this computer only? Your projects keep working.")
	then
		if test -n "$bind_value"
		then
			# Un valore sbagliato si riscrive dov'e', qualunque fosse, e
			# in tutti i gruppi di server che lo impostano: lasciarne uno
			# indietro vuol dire che vince quello.
			perl -pi -e 'BEGIN { $g = "" }
				if (/^\s*\[/) { ($g = $_) =~ s/^\s*\[//; $g =~ s/\].*$//s; $g =~ s/\s//g; $g = lc $g }
				if (($g eq "mysqld" || $g eq "server" || $g eq "mariadb" || $g eq "mariadbd"
				     || $g eq "client-server" || $g =~ /^mysqld-[0-9]/ || $g =~ /^mariadb-[0-9]/)
				    && /^(\s*)bind-address\s*=/) { $_ = "$1bind-address=127.0.0.1\n" }' "$f"
		else
			# Written right after [mysqld], where the section it belongs to starts.
			perl -pi -e 'if (/^\[mysqld\]/ && !$done) {
				$_ .= "\n# Added by vxost security: reachable from this computer only.\n";
				$_ .= "# Do not replace this with skip-networking, which would cut off\n";
				$_ .= "# every project connecting to 127.0.0.1:3306.\n";
				$_ .= "bind-address=127.0.0.1\n";
				$done = 1;
			}' "$f"
		fi

		# Il file si rilegge con lo stesso criterio con cui e' stato letto
		# prima: un perl che non ha trovato nessun [mysqld] non scrive
		# niente e non lo dice.
		bind_value=$(awk '
			/^[[:space:]]*\[/ { g = $0; sub(/^[[:space:]]*\[/, "", g); sub(/\].*$/, "", g); gsub(/[[:space:]]/, "", g); g = tolower(g); next }
			/^[[:space:]]*bind-address[[:space:]]*=/ {
				if (g == "mysqld" || g == "server" || g == "mariadb" || g == "mariadbd" \
				    || g == "client-server" || g ~ /^mysqld-[0-9]/ || g ~ /^mariadb-[0-9]/) {
					v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]#].*$/, "", v); value = v
				}
			}
			END { print value }' "$f")
		if test "$bind_value" != "127.0.0.1"
		then
			echo "VXOST: " $($GETTEXT 'Could not write bind-address under a server group: is there a [mysqld] section in my.cnf?')
			exit 1
		fi
		echo "VXOST: " $($GETTEXT 'my.cnf now says bind-address=127.0.0.1.')
		file_ok="true"
	fi
fi

# ⚠️ Il file non e' il demone. Quello in esecuzione tiene il listener che
# ha aperto all'avvio, e lo cambia solo riavviando: il riavvio si fa, e poi
# si guarda la porta invece di darlo per fatto.
if test "$daemon_ok" = "false" && test "$file_ok" = "true"
then
	echo "VXOST: " $($GETTEXT 'The running MySQL still listens beyond this computer. Restarting it.')
	$VXOST_ROOT/vxost stopmysql
	sleep 2
	$VXOST_ROOT/vxost startmysql
	sleep 3

	if mysql_listens_wide
	then
		echo "VXOST: ${bon}" $($GETTEXT 'MySQL still listens beyond this computer after the restart.') "${boff}"
		echo "VXOST: " $($GETTEXT 'Check with: netstat -an | grep 3306')
		exit 1
	fi
	if mysql_listens
	then
		echo "VXOST: " $($GETTEXT 'MySQL now listens on 127.0.0.1 only.')
	else
		echo "VXOST: " $($GETTEXT 'MySQL did not come back up after the restart: start it from the app.')
		exit 1
	fi
elif test "$daemon_ok" = "true"
then
	echo "VXOST: " $($GETTEXT 'The running MySQL listens on 127.0.0.1 only.')
elif test "$daemon_ok" = "stopped"
then
	echo "VXOST: " $($GETTEXT 'MySQL is not running: the setting applies at the next start.')
fi
