#!/bin/bash
#
# Originally: "MySQL is accessable via network. Do you want me to turn it off?"
# and, on yes, skip-networking in my.cnf.
#
# ⚠️ That answer is wrong for a development stack, and it broke a working
# machine on 05/08/2026. With skip-networking MariaDB accepts Unix sockets
# only, so every project pointing at 127.0.0.1:3306, which is every Laravel and
# every WordPress, stops connecting at the next restart. The default answer was
# yes, so it happened by pressing return.
#
# The protection that was wanted is real: MariaDB with no bind-address listens
# on every interface, so anyone on the same network can reach the database.
# bind-address=127.0.0.1 gives exactly that protection and costs nothing: the
# port stays open on loopback, projects keep working, and the machine next to
# yours cannot see it.
#
# So this script does two things instead of one:
#   - undoes skip-networking if a previous run put it there
#   - sets bind-address to 127.0.0.1 if it is missing
#
# Part of VXOST, GPL-licensed like the file it replaces.
# Original copyright 2002-2003 Kai 'Oswald' Seidler, GPL v2.

if test "x$VXOST_ROOT" = "x"
then
	echo "Dont call this script directly!"
	exit 1
fi

. $VXOST_ROOT/share/vxost/vxostlib

if test "$1" = "check"
then
	check="true"
else
	check="false"
fi

bon="[1m"
boff="[m"

f="$VXOST_ROOT/etc/my.cnf"

# 1. skip-networking left behind by an older run, or by the original script.
active_skip=$(grep -c '^[[:space:]]*skip-networking' "$f")

if test "$active_skip" -gt 0
then
	$check && exit 1

	echo "VXOST: ${bon}" $($GETTEXT 'MySQL is not reachable over TCP at all.') "${boff}"
	echo "VXOST: " $($GETTEXT 'Every project that connects to 127.0.0.1:3306 is broken while this is on.')

	if asky $($GETTEXT "Do you want me to turn TCP back on?")
	then
		perl -pi -e 's/^(\s*)(skip-networking)/$1#$2/' "$f"
		echo "VXOST: " $($GETTEXT 'Turned back on.')
	fi
fi

# 2. The real hardening: listen on loopback only.
#
# ⚠️ Two things get confused here, and the script used to confuse both.
#
# THE GROUP. MariaDB does not read [mysqld] alone: [server], [mariadb],
# [mariadbd], [mysqld-X.Y], [mariadb-X.Y] and [client-server] are read too,
# and the LAST value wins. This file passed the check while the database
# answered the whole network:
#
#     [mysqld]
#     bind-address=127.0.0.1
#     [mariadb]
#     bind-address=0.0.0.0
#
# THE DAEMON. A correct file is not a protected server: MariaDB keeps the
# listener it opened at startup until it restarts. The old early return said
# "not reachable from the network. Good." without ever looking at a socket.
# File and daemon are two answers, and both get reported.

# I gruppi si CHIEDONO al binario, non si trascrivono: quali gruppi legga e'
# un fatto del programma, e una lista scritta a mano invecchia alla prima
# versione. --no-defaults --verbose --help li stampa e non avvia niente.
#
# ⚠️ La lista scritta a mano ne ometteva due, mariadbd-10.4 e galera, e in
# cambio accettava qualunque [mysqld-<numero>]: un [mysqld-99.9] che il
# server ignora veniva letto come se contasse, e bastava a far passare il
# controllo su un file che apre il database alla rete.
mysqld_bin="$VXOST_ROOT/sbin/mysqld"
test -x "$mysqld_bin" || mysqld_bin="$VXOST_ROOT/bin/mysqld"
gruppi=$("$mysqld_bin" --no-defaults --verbose --help 2>/dev/null \
	| sed -n 's/^The following groups are read: *//p' | head -1)
gruppi_letti="true"
if test -z "$gruppi"
then
	# Ripiego esplicito, non un modello: sono i nove gruppi di MariaDB
	# 10.4, letti da questo binario il 14/09/2026. Un elenco si aggiorna
	# quando si guarda; un'espressione regolare accetta anche quello che
	# non esiste.
	gruppi="mysqld server mysqld-10.4 mariadb mariadb-10.4 mariadbd mariadbd-10.4 client-server galera"
	gruppi_letti="false"
fi

# L'ultimo valore dell'opzione $1 fra i gruppi di server. Vuoto se nessuno la
# imposta.
#
# ⚠️ Le due grafie sono la stessa opzione: MariaDB tratta trattino e trattino
# basso come equivalenti nei nomi. Guardando solo "bind-address", una riga
# "bind_address=0.0.0.0" scritta dopo non veniva vista e il file passava.
#
# Una funzione sola, usata anche dopo la riscrittura: due copie dello stesso
# awk divergono alla prima correzione.
leggi_opzione() {
	awk -v gruppi="$gruppi" -v opt="$1" '
		BEGIN {
			n = split(gruppi, a, " ")
			for (i = 1; i <= n; i++) ok[tolower(a[i])] = 1
			gsub(/-/, "[-_]", opt)
			# ⚠️ Il prefisso loose- fa parte della sintassi: dice a MariaDB
			# di ignorare l opzione se non la conosce, non di ignorarla. Il
			# server legge loose-bind-address=0.0.0.0 come bind-address, e
			# questo controllo non la vedeva: un file che apriva il database
			# alla rete passava.
			modello = "^[[:space:]]*(loose[-_])?" opt "[[:space:]]*="
		}
		/^[[:space:]]*\[/ {
			g = $0
			sub(/^[[:space:]]*\[/, "", g)
			sub(/\].*$/, "", g)
			# ⚠️ Solo i bordi. Cancellando TUTTI gli spazi, "[my sqld]"
			# diventava "mysqld" e veniva letto come il gruppo del server,
			# che per MariaDB non e\47. Un gruppo inventato finiva per
			# scavalcare quello vero.
			sub(/^[[:space:]]+/, "", g)
			sub(/[[:space:]]+$/, "", g)
			g = tolower(g)
			next
		}
		$0 ~ modello {
			if (g in ok) {
				v = $0
				sub(/^[^=]*=[[:space:]]*/, "", v)
				sub(/[[:space:]#].*$/, "", v)
				# I valori possono essere fra virgolette: sono sintassi,
				# non parte del valore. bind-address="127.0.0.1" e port="3307"
				# venivano letti con le virgolette dentro, e il primo faceva
				# gridare al lupo mentre il secondo faceva guardare la porta
				# sbagliata.
				if (v ~ /^".*"$/ || v ~ /^\47.*\47$/) {
					v = substr(v, 2, length(v) - 2)
				}
				value = v
			}
		}
		END { print value }' "$f"
}

bind_value=$(leggi_opzione bind-address)

# La porta si legge dal file come tutto il resto. Interrogare sempre la 3306
# vuol dire non aver guardato niente su un'installazione che ne usa un'altra.
port_value=$(leggi_opzione port)
case "$port_value" in
	''|*[!0-9]*) port_value=3306 ;;
esac

# !include porta altre opzioni da un altro file: da qui non si vede cosa
# dicono, e dire "a posto" guardando solo questo sarebbe una risposta data
# senza aver guardato. Copre anche !includedir, che comincia allo stesso modo.
altrove=$(grep -c '^[[:space:]]*!include' "$f")

# Lo stato della porta, in quattro esiti.
#
# ⚠️ "unreadable" e' il quarto, e mancava. netstat che fallisce non vuol dire
# "niente in ascolto": l'esito veniva buttato via dalla pipe, l'assenza di
# righe diventava "il server e' fermo", e in modalita' check si usciva 0 su
# una macchina dove non si era visto proprio niente.
porta_stato=""
leggi_porta() {
	_uscita=$(netstat -an 2>/dev/null)
	if test $? -ne 0
	then
		porta_stato="unreadable"
		return
	fi
	_righe=$(printf '%s\n' "$_uscita" | egrep "[.:]${port_value}[[:space:]].*LISTEN")
	if test -z "$_righe"
	then
		porta_stato="stopped"
		return
	fi
	# Le due forme non sono la stessa su tutti i sistemi:
	# 127.0.0.1.3306 su macOS, 127.0.0.1:3306 altrove.
	if printf '%s\n' "$_righe" \
		| egrep -v "127\.0\.0\.1[.:]${port_value}|\[?::1\]?[.:]${port_value}" \
		| grep -q .
	then
		porta_stato="listening-wide"
	else
		porta_stato="listening-loopback"
	fi
}

file_ok="false"
test "$bind_value" = "127.0.0.1" && test "$altrove" -eq 0 && file_ok="true"

leggi_porta
case "$porta_stato" in
	listening-wide)     daemon_ok="false" ;;
	listening-loopback) daemon_ok="true" ;;
	stopped)            daemon_ok="stopped" ;;
	*)                  daemon_ok="unreadable" ;;
esac

if test "$check" = "true"
then
	# Si esce 0 solo se non c'e' niente da fare E si e' potuto guardare.
	#
	# ⚠️ "unreadable" non e' un via libera: non aver visto non e' aver visto
	# che va bene. Prima bastava "diverso da false", e lo stato sconosciuto
	# passava insieme a quello buono.
	if test "$file_ok" = "true" \
		&& { test "$daemon_ok" = "true" || test "$daemon_ok" = "stopped"; }
	then
		exit 0
	fi
	exit 1
fi

if test "$file_ok" = "true"
then
	echo "VXOST: " $($GETTEXT 'my.cnf says bind-address=127.0.0.1.')
else
	if test "$altrove" -gt 0
	then
		echo "VXOST: ${bon}" $($GETTEXT 'my.cnf pulls in other files with !include: what bind-address ends up being cannot be read from here.') "${boff}"
	elif test -z "$bind_value"
	then
		echo "VXOST: ${bon}" $($GETTEXT 'No server group in my.cnf sets bind-address: MySQL listens on every network interface.') "${boff}"
	else
		echo "VXOST: ${bon}" $($GETTEXT 'The last server group in my.cnf sets bind-address to something other than 127.0.0.1: reachable from the network.') "${boff}"
		echo "VXOST: " "bind-address=$bind_value"
	fi

	if asky $($GETTEXT "Restrict it to this computer only? Your projects keep working.")
	then
		if test -n "$bind_value"
		then
			# Un valore sbagliato si riscrive dov'e', qualunque fosse, e
			# in tutti i gruppi di server che lo impostano: lasciarne uno
			# indietro vuol dire che vince quello.
			# Gli stessi gruppi letti dal binario, e le stesse due
			# grafie: un elenco qui e uno nell'awk divergerebbero.
			VXOST_GRUPPI="$gruppi" perl -pi -e '
				BEGIN { %ok = map { lc($_) => 1 } split /\s+/, $ENV{VXOST_GRUPPI}; $g = "" }
				if (/^\s*\[/) { ($g = $_) =~ s/^\s*\[//; $g =~ s/\].*$//s; $g =~ s/^\s+//; $g =~ s/\s+$//; $g = lc $g }
				if ($ok{$g} && /^(\s*)(loose[-_])?bind[-_]address\s*=/) { $_ = "$1bind-address=127.0.0.1\n" }' "$f"
		else
			# Written right after [mysqld], where the section it belongs to starts.
			perl -pi -e 'if (/^\[mysqld\]/ && !$done) {
				$_ .= "\n# Added by vxost security: reachable from this computer only.\n";
				$_ .= "# Do not replace this with skip-networking, which would cut off\n";
				$_ .= "# every project connecting to 127.0.0.1:3306.\n";
				$_ .= "bind-address=127.0.0.1\n";
				$done = 1;
			}' "$f"
		fi

		# Il file si rilegge con la stessa funzione con cui e' stato
		# letto prima: un perl che non ha trovato nessun gruppo non
		# scrive niente e non lo dice.
		bind_value=$(leggi_opzione bind-address)
		if test "$bind_value" != "127.0.0.1"
		then
			echo "VXOST: " $($GETTEXT 'Could not write bind-address under a server group: is there a [mysqld] section in my.cnf?')
			exit 1
		fi

		# ⚠️ Il valore giusto IN QUESTO FILE non basta. Gli !include si
		# rileggono, perche' uno di loro puo' rimettere bind-address dopo,
		# e da qui non si vede: prima bastava la riscrittura per
		# dichiarare il file a posto, includendo quello che non si era
		# guardato.
		altrove=$(grep -c '^[[:space:]]*!include' "$f")
		if test "$altrove" -gt 0
		then
			echo "VXOST: ${bon}" $($GETTEXT 'my.cnf now says bind-address=127.0.0.1, but it still pulls in other files with !include: what the server ends up using cannot be read from here.') "${boff}"
			file_ok="false"
			exit 1
		fi

		echo "VXOST: " $($GETTEXT 'my.cnf now says bind-address=127.0.0.1.')
		file_ok="true"
	fi
fi

# ⚠️ Il file non e' il demone. Quello in esecuzione tiene il listener che
# ha aperto all'avvio, e lo cambia solo riavviando: il riavvio si fa, e poi
# si guarda la porta invece di darlo per fatto.
if test "$daemon_ok" = "false" && test "$file_ok" = "true"
then
	echo "VXOST: " $($GETTEXT 'The running MySQL still listens beyond this computer. Restarting it.')
	$VXOST_ROOT/vxost stopmysql
	sleep 2
	$VXOST_ROOT/vxost startmysql
	sleep 3

	leggi_porta
	case "$porta_stato" in
		listening-wide)
			echo "VXOST: ${bon}" $($GETTEXT 'MySQL still listens beyond this computer after the restart.') "${boff}"
			echo "VXOST: " $($GETTEXT 'Check with:') "netstat -an | grep $port_value"
			exit 1
			;;
		listening-loopback)
			echo "VXOST: " $($GETTEXT 'MySQL now listens on 127.0.0.1 only.')
			;;
		unreadable)
			# Non si dichiara riuscito un riavvio che non si e' visto.
			echo "VXOST: ${bon}" $($GETTEXT 'Could not read the open ports, so the restart could not be checked.') "${boff}"
			echo "VXOST: " $($GETTEXT 'Check with:') "netstat -an | grep $port_value"
			exit 1
			;;
		*)
			echo "VXOST: " $($GETTEXT 'MySQL did not come back up after the restart: start it from the app.')
			exit 1
			;;
	esac
elif test "$daemon_ok" = "true"
then
	echo "VXOST: " $($GETTEXT 'The running MySQL listens on 127.0.0.1 only.')
elif test "$daemon_ok" = "stopped"
then
	echo "VXOST: " $($GETTEXT 'MySQL is not running: the setting applies at the next start.')
elif test "$daemon_ok" = "unreadable"
then
	echo "VXOST: ${bon}" $($GETTEXT 'Could not read the open ports: whether MySQL is reachable from the network is unknown.') "${boff}"
	echo "VXOST: " $($GETTEXT 'Check with:') "netstat -an | grep $port_value"
fi
